# V1/Vee3 app launch response. Applied once after normal boot setup.
# CPU clocks, voltage, thermal limits and filesystem durability are retained.
on property:sys.boot_completed=1
    # Respond to short bursts without raising the minimum CPU frequency.
    write /sys/devices/system/cpu/cpufreq/ondemand/sampling_rate 20000
    write /sys/devices/system/cpu/cpufreq/ondemand/up_threshold 80
    write /sys/devices/system/cpu/cpufreq/ondemand/down_differential 10
    write /sys/devices/system/cpu/cpufreq/ondemand/sampling_down_factor 2
    write /sys/devices/system/cpu/cpufreq/ondemand/io_is_busy 1

    # Prefer internal eMMC reads while retaining write service opportunities.
    # Deadline expiry values guide dispatch; they are not latency guarantees.
    write /sys/block/mmcblk0/queue/scheduler deadline
    write /sys/block/mmcblk0/queue/iosched/read_expire 100
    write /sys/block/mmcblk0/queue/iosched/write_expire 1000
    write /sys/block/mmcblk0/queue/iosched/writes_starved 2
    write /sys/block/mmcblk0/queue/iosched/fifo_batch 4
    write /sys/block/mmcblk0/queue/read_ahead_kb 128
