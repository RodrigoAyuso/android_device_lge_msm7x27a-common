# Shared Volans init; keep both interfaces in one supplicant.
on post-fs-data
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/wifi/wpa_supplicant 0770 wifi wifi
    write /data/misc/wifi/fwpath ""
    chown wifi wifi /data/misc/wifi/fwpath
    chmod 0660 /data/misc/wifi/fwpath
    write /sys/devices/platform/msm_sdcc.2/polling 1
    start lge-wlan-loader

# IWifi vendor HAL is intentionally absent. Framework 8.1 uses wificond
# and the supplicant directly once the real Volans wlan0 exists.
# This process uses init_module, supported by 3.4. Oreo init's insmod uses
# finit_module, unavailable on this kernel. Failure does not block Android.
service lge-wlan-loader /system/bin/lge-wlan-loader
    class core
    user root
    group root wifi radio log
    seclabel u:r:init:s0
    disabled
    oneshot

on property:wlan.driver.status=ok
    write /sys/devices/platform/msm_sdcc.2/polling 0
on property:wlan.driver.status=failed
    write /sys/devices/platform/msm_sdcc.2/polling 0

# The first P2P-capable interface owns global->p2p_init_wpa_s and is
# classified as P2P by the Oreo HIDL bridge. Register p2p0 first so
# wlan0 is exposed as STA. Keep both interfaces in this single process.
service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
    -g@android:wpa_wlan0 -O/data/misc/wifi/sockets -e/data/misc/wifi/entropy.bin \
    -ip2p0 -Dnl80211 -c/data/misc/wifi/p2p_supplicant.conf -N \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf -puse_p2p_group_interface=1
    class main
    user root
    group wifi inet keystore
    socket wpa_wlan0 dgram 0660 wifi wifi
    disabled
    oneshot
