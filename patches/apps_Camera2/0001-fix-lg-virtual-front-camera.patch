Subject: [PATCH] Camera2: correct LG virtual front preview and mirror saved photos

diff --git a/packages/apps/Camera2/src/com/android/camera/PhotoModule.java b/packages/apps/Camera2/src/com/android/camera/PhotoModule.java
--- a/packages/apps/Camera2/src/com/android/camera/PhotoModule.java
+++ b/packages/apps/Camera2/src/com/android/camera/PhotoModule.java
@@ -905,7 +905,10 @@
 
             final ExifInterface exif = Exif.getExif(originalJpegData);
             final NamedEntity name = mNamedImages.getNextNameEntity();
-            if (mShouldResizeTo16x9) {
+            final boolean mirrorPhoto = VirtualFrontCamera.isAlias(camera.getCameraId());
+            final boolean cropPhoto = mShouldResizeTo16x9;
+            final int mirrorQuality = mCameraSettings.getPhotoJpegCompressionQuality();
+            if (cropPhoto || mirrorPhoto) {
                 final ResizeBundle dataBundle = new ResizeBundle();
                 dataBundle.jpegData = originalJpegData;
                 dataBundle.targetAspectRatio = ResolutionUtil.NEXUS_5_LARGE_16_BY_9_ASPECT_RATIO;
@@ -914,7 +917,13 @@
 
                     @Override
                     protected ResizeBundle doInBackground(ResizeBundle... resizeBundles) {
-                        return cropJpegDataToAspectRatio(resizeBundles[0]);
+                        ResizeBundle result = cropPhoto
+                                ? cropJpegDataToAspectRatio(resizeBundles[0]) : resizeBundles[0];
+                        if (mirrorPhoto) {
+                            result.jpegData = VirtualFrontCamera.mirrorJpeg(
+                                    result.jpegData, result.exif, mirrorQuality);
+                        }
+                        return result;
                     }
 
                     @Override
@@ -1722,14 +1731,16 @@
         mDisplayRotation = CameraUtil.getDisplayRotation();
         Characteristics info =
                 mActivity.getCameraProvider().getCharacteristics(mCameraId);
-        mDisplayOrientation = info.getPreviewOrientation(mDisplayRotation);
+        int previewRotation = VirtualFrontCamera.getDisplayRotation(
+                mCameraId, mDisplayRotation);
+        mDisplayOrientation = info.getPreviewOrientation(previewRotation);
         mUI.setDisplayOrientation(mDisplayOrientation);
         if (mFocusManager != null) {
             mFocusManager.setDisplayOrientation(mDisplayOrientation);
         }
         // Change the camera display orientation
         if (mCameraDevice != null) {
-            mCameraDevice.setDisplayOrientation(mDisplayRotation);
+            mCameraDevice.setDisplayOrientation(previewRotation);
         }
         Log.v(TAG, "setDisplayOrientation (screen:preview) " +
                 mDisplayRotation + ":" + mDisplayOrientation);
diff --git a/packages/apps/Camera2/src/com/android/camera/VideoModule.java b/packages/apps/Camera2/src/com/android/camera/VideoModule.java
--- a/packages/apps/Camera2/src/com/android/camera/VideoModule.java
