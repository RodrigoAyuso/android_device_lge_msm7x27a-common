diff --git a/packages/apps/Camera2/src/com/android/camera/VirtualFrontVideo.java b/packages/apps/Camera2/src/com/android/camera/VirtualFrontVideo.java
new file mode 100644
index 0000000..365e179
--- /dev/null
+++ b/packages/apps/Camera2/src/com/android/camera/VirtualFrontVideo.java
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.camera;
+
+import android.hardware.Camera;
+import android.util.Log;
+
+/** Request encoder pixel reflection without changing the preview stream. */
+final class VirtualFrontVideo {
+    private static final String TAG = "VirtualFrontVideo";
+    private VirtualFrontVideo() { }
+
+    static boolean configureVideoMirror(Camera camera, int cameraId, int rotation) {
+        if (camera == null) {
+            return false;
+        }
+        final boolean alias = VirtualFrontCamera.isAlias(cameraId);
+        Camera.Parameters parameters = camera.getParameters();
+        if (!"off,flip-h,flip-v".equals(parameters.get("lg-virtual-front-video-mirror-values"))) {
+            if (alias) {
+                Log.e(TAG, "LG virtual front: recording mirror requires the matching camera HAL");
+            }
+            return false;
+        }
+        // Reflection is horizontal after the MP4 orientation is applied.
+        String flip = !alias ? "off" : (rotation == 90 || rotation == 270) ? "flip-v" : "flip-h";
+        parameters.set("lg-virtual-front-video-mirror", flip);
+        camera.setParameters(parameters);
+        if (alias) {
+            Log.i(TAG, "LG virtual front: request encoder pixel mirror " + flip);
+        }
+        return alias;
+    }
+
+}
