     private boolean mFocusAreaSupported;
     private boolean mMeteringAreaSupported;
 
@@ -1125,6 +1126,15 @@ public class VideoModule extends CameraModule
             }
             requestedSizeLimit = myExtras.getLong(MediaStore.EXTRA_SIZE_LIMIT);
         }
+        // Drain pending proxy settings before configuring the still-locked camera.
+        // This must precede unlock(), when ownership is passed to MediaRecorder.
